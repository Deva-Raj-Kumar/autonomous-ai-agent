# Copy this file to .env and fill in real values:   copy .env.example .env
# .env is git-ignored. NEVER commit real keys. This example file IS committed.

# ---------- General ----------
APP_NAME="Autonomous AI Agent"
ENVIRONMENT=development        # development | test | production
DEBUG=false
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# ---------- LLM provider ----------
LLM_PROVIDER=gemini            # gemini | openai
# Check which models your key can use:  python -m app.cli models
# gemini-3.1-flash-lite = fast (default) | gemini-3.5-flash = stronger reasoning, slower
GEMINI_MODEL=gemini-3.1-flash-lite
# Used automatically when the main model is overloaded (503 "high demand"), rate limited
# (429) or times out. [] disables fallbacks.
GEMINI_FALLBACK_MODELS=["gemini-3.5-flash-lite"]
OPENAI_MODEL=gpt-4.1-mini      # only if LLM_PROVIDER=openai (also: pip install langchain-openai)
LLM_TEMPERATURE=0.0            # 0 = most repeatable answers
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# Gemini key from https://aistudio.google.com/apikey  (GEMINI_API_KEY also works)
GOOGLE_API_KEY=your-gemini-api-key-here
# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ---------- Database ----------
# Leave unset to use data/agent.db (SQLite, fine for quick local experiments).
# Format: dialect+driver://user:password@host:port/dbname  (no quotes, no f"...")
# Special characters in the password must be URL-encoded:  @ -> %40   : -> %3A   / -> %2F
# MySQL (Phase 11):
# DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/YOUR_DB?charset=utf8mb4
# PostgreSQL alternative:
# DATABASE_URL=postgresql+psycopg://YOUR_USER:YOUR_PASSWORD@localhost:5432/YOUR_DB
# After changing the database, create/upgrade its tables with:  alembic upgrade head
# true = run pending migrations at startup (handy locally; keep false in production).
DB_AUTO_MIGRATE=false

# ---------- Planner ----------
MAX_PLAN_TASKS=12             # plans bigger than this are rejected
PLANNER_MAX_ATTEMPTS=3        # first draft + up to 2 repairs

# ---------- Tools ----------
SEARCH_PROVIDER=auto           # auto | tavily | duckduckgo  (auto = Tavily if key set)
TAVILY_API_KEY=                # free key: https://app.tavily.com  (optional)
SEARCH_MAX_RESULTS=5
DOCUMENTS_DIR=data/documents   # the ONLY folder read_file may open
MAX_FILE_SIZE_MB=10
TOOL_MAX_OUTPUT_CHARS=8000
PYTHON_EXEC_TIMEOUT_SECONDS=10

# ---------- Memory ----------
MEMORY_RECENT_MESSAGES=10      # chat messages sent word-for-word
MEMORY_SUMMARIZE_AFTER=20      # older messages get folded into a running summary
MEMORY_MAX_RESULTS=5           # long-term memories per prompt
MEMORY_EXTRACTION_ENABLED=true # one extra LLM call per turn to learn lasting facts
MEMORY_SEMANTIC_SEARCH=true    # also match memories by meaning (embeddings)

# ---------- RAG ----------
EMBEDDING_PROVIDER=local       # local (free, offline after ~80 MB download) | gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=768
CHROMA_DIR=data/chroma         # where vectors are stored
RAG_CHUNK_SIZE=800             # characters per chunk
RAG_CHUNK_OVERLAP=150          # must be smaller than RAG_CHUNK_SIZE
RAG_TOP_K=4                    # chunks given to the LLM
RAG_CANDIDATES=20              # chunks fetched before reranking
RAG_RERANKER=hybrid            # hybrid | llm | none

# ---------- Agent safety limits ----------
MAX_AGENT_STEPS=15             # every tool attempt (incl. retries) is one step
MAX_TASK_RETRIES=2
TOOL_TIMEOUT_SECONDS=30
AGENT_RUN_TIMEOUT_SECONDS=300  # whole-run time limit
AGENT_RETRY_DELAY_SECONDS=1    # backoff: 1s, 2s, 4s...
AGENT_MAX_PARALLEL_TASKS=4     # tasks of one wave running at the same time

# ---------- LangGraph workflow ----------
CHECKPOINT_DB_PATH=data/checkpoints.db   # saved run state (pause/resume, survives restarts)
MAX_EVALUATION_ROUNDS=1        # extra rounds the evaluator may send tasks back
EVALUATION_MODE=llm            # llm (rules + evidence + LLM judge) | rules
JUDGE_PASS_SCORE=5             # judge score (0-10) below which a result is redone
MAX_REPLANS=1                  # times the agent may discard a plan and re-plan
GRAPH_RECURSION_LIMIT=100      # LangGraph guard against endless graph loops

# ---------- Safety & permissions ----------
DISABLED_TOOLS=[]                                  # e.g. ["python_exec"]
EMAIL_ALLOWED_RECIPIENTS=[]                        # e.g. ["mentor@example.com", "@college.edu"]; empty = no email allowed
EMAIL_OUTBOX_DIR=data/outbox                       # emails are saved here as .eml, not sent
# Email Delivery Mode: outbox | gmail
EMAIL_MODE=gmail
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/email/oauth/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
TOOL_RATE_LIMITS_PER_MINUTE={"web_search": 20, "python_exec": 10, "send_email": 5}
TOOL_BUDGETS_PER_RUN={"web_search": 12, "python_exec": 3, "send_email": 3}
INJECTION_SCAN_ENABLED=true

# ---------- Authentication & API (Phase 12) ----------
# Signs login tokens. REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Empty in development = random key per start (everyone is logged out on restart).
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_DAYS=7           # refresh tokens rotate on every use
ALLOW_REGISTRATION=true        # false = only `python -m app.cli users create` makes accounts
LOGIN_MAX_FAILURES=5           # per email + IP, within the window below
LOGIN_WINDOW_MINUTES=15
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]   # only for pages on another origin
